# Server Environment Variables (Vercel / Node.js)
# Set these securely in your Vercel Dashboard -> Settings -> Environment Variables
# NEVER commit your actual .env file or API keys to GitHub!

# Google Gemini API Key (for Charlo AI live generation)
# Get a 100% free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (optional ultra-fast Llama 3.3 70B fallback)
# GROQ_API_KEY=your_groq_api_key_here
